{
  "name": "daily-tracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@tabby_ai/hijri-converter": "^1.0.5",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "**/*.test.ts?(x)"
    ]
  }
}
